APP_ENV=development
LOG_LEVEL=info

MONGO_URI=mongodb://localhost:27017
MONGO_DB=mail_suite

JWT_SECRET=change-me-to-a-32-byte-random
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

SERVER_PORT=9090
PUBLIC_URL=http://localhost:9090

# Local mail server (Postfix/Dovecot on the same host)
IMAP_HOST=127.0.0.1
IMAP_PORT=143
SMTP_HOST=127.0.0.1
SMTP_PORT=587

# Betazen panel (for DNS upserts + forwarder writes)
BETAZEN_PANEL_URL=
BETAZEN_PANEL_TOKEN=

# FCM
FCM_CREDENTIALS_FILE=
FCM_PROJECT_ID=

# WebAuthn
WEBAUTHN_RPID=localhost
WEBAUTHN_RP_NAME=Betazen Mail
WEBAUTHN_ORIGINS=http://localhost:5173,http://localhost:9090

# OAuth2 provider
OAUTH_ISSUER=http://localhost:9090
